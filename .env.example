# Copy to .env and fill in.  .env is gitignored; never commit real keys.
#
# Credentials are looked up by the env-var names given in a config's
# `stores:` block, so these names are only the defaults used by
# configs/examples/*.yaml.

# AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Backblaze B2 (S3-compatible API).  Find the endpoint with:
#   curl -s -u "<keyId>:<appKey>" https://api.backblazeb2.com/b2api/v3/b2_authorize_account \
#     | python -c "import json,sys; print(json.load(sys.stdin)['apiInfo']['storageApi']['s3ApiUrl'])"
B2_KEY_ID=
B2_APP_KEY=
