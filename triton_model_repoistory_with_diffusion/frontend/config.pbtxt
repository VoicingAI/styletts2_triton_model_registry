name: "frontend"
backend: "python"

input [
  { name: "TEXT",     data_type: TYPE_STRING, dims: [ 1, 1 ] },
  { name: "SPEAKER",  data_type: TYPE_STRING, dims: [ 1, 1 ] },
  { name: "LANGUAGE", data_type: TYPE_STRING, dims: [ 1, 1 ] },
  { name: "SPEED", data_type: TYPE_FP32, dims: [ 1, 1 ] }
]

output [
  { name: "ALPHA",   data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "BETA",   data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "TOKENS",   data_type: TYPE_INT64, dims: [ -1, -1 ] },
  { name: "INPUT_LENGTHS", data_type: TYPE_INT64, dims: [ 1 ] },
  { name: "TEXT_MASK", data_type: TYPE_BOOL, dims: [ 1, -1] },
  { name: "ATTENTION_MASK", data_type: TYPE_INT64, dims: [ 1, -1] },
  { name: "REF_S", data_type: TYPE_FP32, dims: [ -1, 256 ] },
  { name: "SPEED_OUT", data_type: TYPE_FP32, dims: [ 1, 1 ] }
]

instance_group [ { kind: KIND_GPU, count: 1} ]



# Directory holding <speaker>.pt style vectors, as written by convert.py into
# triton_repos/<model_id>/reference_styles/. Mount it here.
parameters: { key: "REFERENCE_STYLES_DIR", value: { string_value: "/workspace/reference_styles" } }
parameters: { key: "DEFAULT_LANGUAGE", value: { string_value: "en" } }
