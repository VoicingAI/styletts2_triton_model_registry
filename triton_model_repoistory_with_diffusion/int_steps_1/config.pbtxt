name: "int_steps_1"
backend: "onnxruntime"
max_batch_size : 0

input [
  { name: "ALPHA",   data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "BETA",   data_type: TYPE_FP32, dims: [ -1 ] },
  { name: "S_PRED",   data_type: TYPE_FP32, dims: [ -1, 256 ] },
  { name: "REF_S", data_type: TYPE_FP32, dims: [ -1, 256 ] },
  { name: "T_EN",   data_type: TYPE_FP32, dims: [ -1, 512, -1 ] }
]

output [
  { name: "REF",   data_type: TYPE_FP32, dims: [ -1, 128 ] },
  { name: "S_OUT",   data_type: TYPE_FP32, dims: [ -1, 128 ] },
  { name: "TEXT_MASK_PRED",   data_type: TYPE_BOOL, dims: [ -1, -1 ] }
]

instance_group [ { kind: KIND_GPU, count: 1} ]


parameters { key: "cudnn_conv_algo_search" value: { string_value: "1" } }
