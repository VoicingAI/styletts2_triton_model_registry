name: "bert"
backend: "tensorrt"
max_batch_size : 0

input [
  { name: "TOKENS",   data_type: TYPE_INT64, dims: [ -1, -1 ] },
  { name: "ATTENTION_MASK", data_type: TYPE_INT64, dims: [ 1, -1] }
]

output [
  { name: "BERT_DUR",   data_type: TYPE_FP32, dims: [ -1, -1, 768 ] }
]

instance_group [ { kind: KIND_GPU, count: 1} ]



parameters { key: "cudnn_conv_algo_search" value: { string_value: "1" } }
