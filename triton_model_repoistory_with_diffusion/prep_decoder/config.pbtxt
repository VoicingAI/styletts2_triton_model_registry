name: "prep_decoder"
backend: "onnxruntime"
max_batch_size: 0

input [
   { name: "F0_PRED",   data_type: TYPE_FP32, dims: [ -1, -1 ] },
    { name: "N_PRED",   data_type: TYPE_FP32, dims: [ -1, -1 ] }
]

output [
  { name: "F0_OUT",   data_type: TYPE_FP32, dims: [ -1, 1, -1 ] },
  { name: "N_OUT",   data_type: TYPE_FP32, dims: [ -1, 1, -1 ] }
]

instance_group [ { kind: KIND_GPU, count: 1} ]