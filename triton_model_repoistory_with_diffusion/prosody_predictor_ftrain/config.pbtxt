name: "prosody_predictor_ftrain"
backend: "tensorrt"
max_batch_size : 0

input [
    { name: "EN",   data_type: TYPE_FP32, dims: [ -1, 640, -1 ] },
    { name: "S_OUT",   data_type: TYPE_FP32, dims: [ -1, 128 ] }
]

output [
    { name: "F0_PRED",   data_type: TYPE_FP32, dims: [ -1, -1 ] },
    { name: "N_PRED",   data_type: TYPE_FP32, dims: [ -1, -1 ] }
]

instance_group [ { kind: KIND_GPU, count: 1} ]


parameters { key: "cudnn_conv_algo_search" value: { string_value: "1" } }
